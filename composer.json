{
    "name": "inep/painel-risk-manager",
    "description": "Painel Risk Manager - Migração Laminas PHP 8",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0",
        "laminas/laminas-component-installer": "^3.2",
        "laminas/laminas-mvc": "^3.6",
        "laminas/laminas-mvc-i18n": "^1.7",
        "laminas/laminas-mvc-plugins": "^1.2",
        "laminas/laminas-db": "^2.18",
        "laminas/laminas-form": "^3.9",
        "laminas/laminas-inputfilter": "^2.24",
        "laminas/laminas-filter": "^2.32",
        "laminas/laminas-i18n": "^2.23",
        "laminas/laminas-log": "^2.16",
        "laminas/laminas-mail": "^2.22",
        "laminas/laminas-di": "^3.12",
        "laminas/laminas-servicemanager": "^3.20",
        "laminas/laminas-session": "^2.16",
        "laminas/laminas-view": "^2.27",
        "laminas/laminas-json": "^3.6",
        "laminas/laminas-http": "^2.18",
        "laminas/laminas-config": "^3.9",
        "laminas/laminas-modulemanager": "^2.14",
        "laminas/laminas-loader": "^2.10",
        "laminas/laminas-eventmanager": "^3.10",
        "laminas/laminas-authentication": "^2.13",
        "laminas/laminas-permissions-acl": "^2.13",
        "laminas/laminas-console": "^2.8",
        "laminas/laminas-router": "^3.11",
        "laminas/laminas-validator": "^2.30",
        "laminas/laminas-escaper": "^2.12",
        "laminas/laminas-navigation": "^2.18",
        "laminas/laminas-uri": "^2.10",
        "laminas/laminas-math": "^3.7",
        "laminas/laminas-crypt": "^3.10",
        "laminas/laminas-serializer": "^2.16",
        "laminas/laminas-soap": "^2.12",
        "laminas/laminas-cache": "^3.10",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.3",
        
        "dompdf/dompdf": "^2.0",
        "mitoteam/jpgraph": "^10.3"
    },
    "autoload": {
        "psr-4": {
            "Application\\": "module/Application/src/",
            "Dashboard\\": "module/Dashboard/src/",
            "Autenticacao\\": "module/Autenticacao/src/",
            "Usuario\\": "module/Usuario/src/",
            "Estrutura\\": "module/Estrutura/src/",
            "Gerador\\": "module/Gerador/src/",
            "Modulo\\": "module/Modulo/src/",
            "RiskManager\\": "module/RiskManager/src/",
            "Base\\": "module/Base/src/",
            "Mobile\\": "module/Mobile/src/",
            "Classes\\": "module/Classes/src/"
        },
        "classmap": [
            "library/moduloapi"
        ]
    },
    "config": {
        "allow-plugins": {
            "laminas/laminas-component-installer": true
        }
    }
}