{
    "name": "painel/laminas-application",
    "description": "Painel application migrated from Zend Framework 2 to Laminas MVC",
    "license": "BSD-3-Clause",
    "keywords": [
        "framework",
        "laminas",
        "mvc"
    ],
    "homepage": "https://getlaminas.org/",
    "require": {
        "php": "~8.4.0",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-gd": "*",
        "ext-intl": "*",
        "ext-mbstring": "*",
        "ext-mysqli": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "ext-zip": "*",
        "dompdf/dompdf": "^3.1",
        "laminas/laminas-cache": "^3.12",
        "laminas/laminas-cache-storage-adapter-filesystem": "^2.3",
        "laminas/laminas-config": "^3.3",
        "laminas/laminas-db": "^2.11",
        "laminas/laminas-filter": "^2.9",
        "laminas/laminas-form": "^3.21",
        "laminas/laminas-http": "^2.13",
        "laminas/laminas-i18n": "^2.9",
        "laminas/laminas-i18n-resources": "^2.6",
        "laminas/laminas-inputfilter": "^2.10",
        "laminas/laminas-loader": "^2.6",
        "laminas/laminas-modulemanager": "^2.8",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-serializer": "^2.9",
        "laminas/laminas-session": "^2.9",
        "laminas/laminas-servicemanager": "^3.23",
        "laminas/laminas-validator": "^2.13",
        "laminas/laminas-view": "^2.11",
        "laminas/laminas-xml": "^1.2",
        "laminas/laminas-mvc-plugin-flashmessenger": "^1.0",
        "laminas/laminas-hydrator": "^4.3",
        "laminas/laminas-diactoros": "^3.8",
        "mezzio/mezzio": "^3.28",
        "mezzio/mezzio-fastroute": "^3.14",
        "twbs/bootstrap": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/App/"
        }
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "platform": {
            "php": "8.4.20"
        }
    },
    "prefer-stable": true
}
