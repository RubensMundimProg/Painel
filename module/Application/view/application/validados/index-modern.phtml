                        <?php $checked = in_array($option, $categoriasSelecionadas) ? 'checked="checked"' : ''; ?>
                        <label class="modern-check-chip">
                            <input type="checkbox" name="Categoria[]" value="<?= $this->escapeHtmlAttr($option) ?>" <?= $checked ?>>
                            <span><?= $this->escapeHtml($option) ?></span>
                        </label>
