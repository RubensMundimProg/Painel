            <span class="modern-stat-value"><?= $this->escapeHtml(count($categoriasAtivas)) ?></span>
            <span class="modern-stat-label">Categorias ativas</span>
        </div>
        <div class="modern-stat-card">
            <span class="modern-stat-value"><?= $this->escapeHtml($comAnexo) ?></span>
            <span class="modern-stat-label">Com anexo</span>
