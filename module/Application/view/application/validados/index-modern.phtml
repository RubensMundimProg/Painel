<?php
$fechados = $fechados ?? false;
$baseUrl = $fechados ? '/validados/fechados' : '/validados';
$limparUrl = $fechados ? '/validados/limpar/fechados?ui=modern' : '/validados/limpar?ui=modern';
$tituloPagina = $fechados ? 'Histórico de Alertas' : 'Alertas em aberto';
$kicker = $fechados ? 'Alertas fechados' : 'Alertas validados';
$totalLabel = $fechados ? 'Alertas fechados' : 'Alertas abertos';
$emptyText = $fechados
    ? 'Nenhum alerta fechado foi retornado para a avaliação e filtros atuais.'
    : 'Nenhum alerta aberto foi retornado para a avaliação e filtros atuais.';
$form->get('OrigemInformacao')->setAttribute('class', 'form-select')->setLabel('');
$form->get('UfFiltro')->setAttribute('class', 'form-select')->setLabel('');
$form->get('DataRegistro')->setAttribute('class', 'form-control datepicker')->setLabel('');
$filtrosAbertos = count($categoriasSelecionadas) > 0
    || (string)$form->get('OrigemInformacao')->getValue() !== ''
    || (string)$form->get('UfFiltro')->getValue() !== ''
    || (string)$form->get('DataRegistro')->getValue() !== '';

$total = count($lista);
$comAnexo = 0;
$semAtualizacao = 0;
$categoriasAtivas = [];

foreach ($lista as $statItem) {
    $statAnexos = $statItem->getCustomAttribute('anexo');
    if (is_array($statAnexos) && count($statAnexos) > 0) {
        $comAnexo++;
    }

    if (!$statItem->getCustomAttribute('ultimo_progresso')) {
        $semAtualizacao++;
    }

    $categoriaStat = (string) $statItem->getCustomAttribute('categoria_evento');
    if ($categoriaStat !== '') {
        $categoriaPrincipal = explode(' - ', $categoriaStat)[0];
        $categoriasAtivas[$categoriaPrincipal] = true;
    }
}
?>

<div class="menu d-none" data-menu="Atualizar Progresso dos Alertas"></div>

<div class="modern-page" data-menu="Alertas Validados">
    <header class="modern-page-header">
