        <div class="modern-filter-title">
            <button class="modern-filter-toggle" type="button" data-bs-toggle="collapse" data-bs-target="#validadosFilters" aria-expanded="<?= $filtrosAbertos ? 'true' : 'false' ?>" aria-controls="validadosFilters">
                <span>Filtros</span>
                <span class="modern-filter-arrow"></span>
            </button>
        </div>

