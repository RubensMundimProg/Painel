                            </td>
                            <td class="hidden-print action" data-label="Ações">
                                <div class="modern-row-actions">
                                    <?php if (!$fechados) : ?>
                                        <button type="button" class="btn btn-sm btn-outline-primary update-progress" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                            Atualizar
                                        </button>
                                    <?php endif; ?>
                                    <button type="button" class="btn btn-sm btn-outline-secondary view-progress" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                        Histórico
                                    </button>
                                    <?php if ($status === 'Aberto') : ?>
                                        <button type="button" class="btn btn-sm btn-outline-danger update-status change-status" data-id="<?= $this->escapeHtmlAttr($code) ?>" data-status="2">
                                            Fechar
                                        </button>
