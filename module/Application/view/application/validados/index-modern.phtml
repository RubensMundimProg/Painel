                            <td class="update-progress" data-label="Origem" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?= $this->escapeHtml($item->getCustomAttribute('origem_informacao')) ?>
                            </td>
                            <td class="update-progress status-registro" data-label="Status" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <span class="modern-badge <?= $this->escapeHtmlAttr($statusClass) ?>"><?= $this->escapeHtml($status) ?></span>
                            </td>
                            <td class="update-progress" data-label="Data/Hora" data-id="<?= $this->escapeHtmlAttr($code) ?>">
