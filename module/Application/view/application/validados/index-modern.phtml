        </div>

        <div class="modern-table-wrap">
            <table class="modern-table modern-alert-table <?= $total > 0 ? 'datatable' : '' ?>" id="modern-validados-table">
                <thead>
                <tr>
                        <th>Município</th>
                    <th>Exame</th>
                        <th>Coordenação</th>
                    <th>Categoria</th>
