                    <th>Usuario</th>
                    <th>Triagem por</th>
                    <th>Origem</th>
                    <th>Status</th>
                    <th>Data/Hora</th>
                        <th>Última atualização</th>
                    <th>Anexo</th>
                        <th>Ações</th>
                </tr>
                </thead>
                <tbody>
                <?php if ($total === 0) : ?>
                <?php else : ?>
                    <?php foreach ($lista as $item) : ?>
                        <?php
                        $anexo = $item->getCustomAttribute('anexo');
                        if (!is_array($anexo)) {
                            $anexo = [];
                        }

                        $item->setCode($item->getCustomAttribute('EventID'));
                        $code = $item->getCode();
                        $coordenacao = (string) $item->getCustomAttribute('coordenacao');
                        $status = (string) $item->getStatus();
                        $statusClass = $status === 'Aberto' ? 'success' : ($status === 'Fechado' ? 'warning' : 'danger');
                        $exameBadge = '';
                        $exameClass = 'primary';

                        if (stripos($coordenacao, 'ENEM') !== false) {
                            $exameBadge = 'ENEM';
                        } elseif (stripos($coordenacao, 'CPNU') !== false) {
                            $exameBadge = 'CPNU';
                            $exameClass = 'warning';
                        }
                        ?>
                        <tr>
                            <td class="update-progress" data-label="Município" data-id="<?= $this->escapeHtmlAttr($code) ?>">
