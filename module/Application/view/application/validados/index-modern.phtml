                            </td>
                            <td class="update-progress" data-label="Exame" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?php if ($exameBadge) : ?>
                                    <span class="modern-badge <?= $this->escapeHtmlAttr($exameClass) ?>"><?= $this->escapeHtml($exameBadge) ?></span>
                                <?php else : ?>
                                    <span class="modern-muted">-</span>
                                <?php endif; ?>
                            </td>
                            <td class="update-progress" data-label="Coordenação" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?= $this->escapeHtml($coordenacao) ?>
                            </td>
                            <td class="update-progress" data-label="Categoria" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?= $this->escapeHtml($item->getCustomAttribute('categoria_evento')) ?>
                            </td>
                            <td class="update-progress modern-description" data-label="Descrição" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?= $this->escapeHtml($item->getDescription()) ?>
                            </td>
                            <td class="update-progress modern-description" data-label="Providências" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?= $this->escapeHtml($item->getCustomAttribute('providencias_adotadas')) ?>
                            </td>
                            <td class="update-progress" data-label="Usuario" data-id="<?= $this->escapeHtmlAttr($code) ?>">
                                <?= $this->escapeHtml($item->getCustomAttribute('usuario_cadastro')) ?>
