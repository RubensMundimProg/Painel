<script>
    $(function () {
        $('body').on('change', '#modern-select-all', function () {
            $('.arquivar-check:visible').prop('checked', this.checked);
        });

        $('body').on('click', '[data-modern-archive]', function () {
            msgConfirmacao('/triagem/excluir-triagem', $(this).attr('data-modern-archive'), 'exclusao', 'ocorrencia');
        });

        $('body').on('click', '.arquivar-varios', function () {
            var dados = [];
            $('.arquivar-check:checked').each(function () {
                dados.push($(this).attr('data-id'));
            });

            if (!dados.length) {
                showMsg('Selecione pelo menos 1 registro', false, true);
                return false;
            }

            $.ajax({
                url: '/triagem/arquivar-varios',
                dataType: 'json',
                type: 'POST',
                data: {'dados': dados},
                success: function (res) {
                    if (res.error) {
                        showMsg('Erro ao arquivar as ocorrências selecionadas', false, true);
                        return;
                    }

                    location.reload();
                }
            });
        });
    });
</script>
