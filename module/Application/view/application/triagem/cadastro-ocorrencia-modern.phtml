<?php
$setClass = function ($name, $class) use ($form) {
    if (!$form->has($name)) {
        return;
    }

    $element = $form->get($name);
    $current = trim((string)$element->getAttribute('class'));
    $element->setAttribute('class', trim($current . ' ' . $class));
};

$setClass('DiaAplicacao', 'form-select');
$setClass('municipio', 'form-control');
$setClass('coordenacao', 'form-select');
